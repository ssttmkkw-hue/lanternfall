{
  "name": "lanternfall",
  "private": true,
  "version": "0.1.0",
  "description": "Lanternfall: a co-op browser game where human and AI Lanterners keep the Hearth burning.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "headless": "tsx tools/run-headless.ts",
    "golden": "tsx tools/make-golden.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
